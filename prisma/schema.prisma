// Qimby pilot backend — PostgreSQL via Prisma 7 (driver adapter: @prisma/adapter-pg).
// All timestamps are stored as timestamptz (UTC); the UI renders them in the location's timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitType {
  freezer
  walk_in_freezer
  walk_in_cooler
  ac
}

enum AlertType {
  temp_out_of_range
  offline
}

/// Who someone is, and therefore what they can reach. One role per user.
enum UserRole {
  /// Qimby's own team. Above the organizations rather than inside one, so an admin has no
  /// organizationId and sees everything. This is us, not a customer.
  admin
  /// Owns an organization and sees all of it. There may be more than one, and one of them
  /// may add another — but never the last one away, or nobody is left to let people in.
  owner
  /// Sees the locations of the districts assigned to them. May invite technicians, and only
  /// technicians: a manager who could mint managers would widen their own reach.
  district_manager
  /// Sees the locations assigned to them, one by one. Files the work reports.
  technician
}

/// Where an account is in its life. Accounts are never deleted — a technician who leaves still
/// authored the reports that explain what happened to a compressor two years ago.
enum UserStatus {
  /// Invited, has not set a password yet.
  invited
  /// Can sign in.
  active
  /// Cannot sign in, sessions revoked, still named on everything they wrote.
  deactivated
}

/// A customer. One today — Steven's — and the column exists everywhere from the start so that
/// the second one costs a row rather than a migration.
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// Telegram chat that receives this customer's alerts. Null sends them to the default group
  /// (TELEGRAM_CHAT_ID), which is also where Qimby's own system messages always go. One
  /// customer's restaurants must never reach another customer's chat.
  telegramChatId String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  users     User[]
  districts District[]
  locations Location[]
}

/// A group of locations under one or more district managers. A location may have no district,
/// in which case only the owners of its organization can see it.
model District {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]
  managers     UserDistrict[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Which districts a district manager covers. Several managers may share a district.
model UserDistrict {
  userId     String
  districtId String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@id([userId, districtId])
  @@index([userId])
}

enum AuthTokenType {
  email_verify
  password_reset
}

/// Application accounts. Passwords are stored as scrypt hashes only — the plaintext never
/// touches the database or the logs. Sensor data has no relation to users, so deleting an
/// account never deletes readings.
model User {
  id              String     @id @default(cuid())
  email           String     @unique // stored lowercase
  name            String?
  passwordHash    String
  /// New accounts start with no visibility at all — an account is useless until someone
  /// grants it a location, which is what stops an open sign-up form from handing a stranger
  /// the whole estate.
  role            UserRole   @default(technician)
  /// Set for everyone inside a customer. Null for Qimby's own team, who stand outside.
  organizationId  String?
  status          UserStatus @default(invited)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
  tokens       AuthToken[]
  access       LocationAccess[]
  districts    UserDistrict[]
  unitChanges  UnitChange[]
  unitPhotos   UnitPhoto[]
  passportEdits Unit[] @relation("PassportUpdates")

  @@index([organizationId])
}

/// Which locations a `client` account may see. Ignored for `admin`, who sees everything.
/// A row per user per location: a franchisee gets one, a technician covering a dozen
/// restaurants gets a dozen, and neither needs a different model.
model LocationAccess {
  userId     String
  locationId String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
}

/// Server-side sessions. `id` is the sha256 of the cookie value, so a database leak can't be replayed.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use e-mail tokens (verification, password reset). `id` is the sha256 of the raw token.
model AuthToken {
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  expiresAt DateTime      @db.Timestamptz(6)
  usedAt    DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@index([userId, type])
}

model Location {
  id             String   @id @default(cuid())
  name           String   @unique // "Burger King #1025"
  address        String
  city           String
  state          String
  zip            String
  lat            Float
  lng            Float
  timezone       String   @default("America/New_York")
  /// Which customer this belongs to. An owner sees their organization whole, districts or not.
  organizationId String?
  /// Null means "no district": visible to the owners, to no manager.
  districtId     String?
  /// A restaurant that closed, or was never really ours. Never deleted: its readings and alerts
  /// are history worth keeping. While set, it is off every list, map and counter, and raises no
  /// alerts — but an uplink from a sensor still there is stored, so reactivating loses nothing.
  deactivatedAt  DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  district     District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  gateways     Gateway[]
  units        Unit[]
  sensors      Sensor[]
  access       LocationAccess[]
  weather      WeatherReading[]

  @@index([organizationId])
  @@index([districtId])
}

/// The air outside a restaurant, from Open-Meteo, so an AC chart can show what the unit was
/// up against. Sampled every quarter hour by the minute loop and backfilled by the hour
/// (`npm run weather:backfill`); Open-Meteo's own timestamps, so a sample seen twice is one row.
model WeatherReading {
  id         Int      @id @default(autoincrement())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  tempF      Float
  /// WMO weather code, for the card's icon
  code       Int?
  measuredAt DateTime @db.Timestamptz(6)

  @@unique([locationId, measuredAt])
}

model Gateway {
  id           String    @id @default(cuid())
  ttnGatewayId String    @unique // "lps8n-teaneck"
  eui          String?   @unique
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  lastSeenAt   DateTime? @db.Timestamptz(6)

  @@index([locationId])
}

model Unit {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  type        UnitType
  name        String // "Freezer - Back"
  model       String?
  serial      String?
  year        Int?
  /// Refrigerant type, e.g. "R-448A". Entered by the technician at installation.
  refrigerant String?
  /// The rest of the nameplate, for an AC: what a technician buying a replacement needs to
  /// know. Free text, as written on the part — "A42, 2 шт", "45/5 µF, 370V", "20x25x1, 2 шт".
  belts       String?
  capacitor   String?
  filter      String?
  /// Who last touched the passport and when; every change is also a UnitChange row.
  passportUpdatedAt   DateTime? @db.Timestamptz(6)
  passportUpdatedById String?
  passportUpdatedBy   User?     @relation("PassportUpdates", fields: [passportUpdatedById], references: [id], onDelete: SetNull)
  /// The normal band: what the table calls "Normal Range" and the chart paints green.
  /// Leaving it colours the reading, but on its own raises nothing.
  rangeMinF   Float
  rangeMaxF   Float
  /// Where trouble actually starts. A walk-in freezer is normal to 10 °F and alarming from
  /// 20 °F — it spends most of its day in between, defrosting and having its door opened, and
  /// alerting on all of that would be noise. Crossing these, and staying across for an hour,
  /// is what opens an alert. Null falls back to the normal band.
  alertMinF   Float?
  alertMaxF   Float?
  /// An AC is judged by the room, but its duct probe has a normal band of its own worth
  /// drawing on the chart. It does not decide the unit's status.
  probeMinF   Float?
  probeMaxF   Float?

  channels SensorChannel[]
  readings Reading[]
  alerts   Alert[]
  changes  UnitChange[]
  photos   UnitPhoto[]

  @@unique([locationId, name])
  @@index([locationId])
}

/// A photo of the unit's nameplate, at most five per unit. The bytes live in object storage
/// (Supabase Storage in production, a local folder in development) under `path`; this row is
/// what says the photo exists and who may see it — the unit's location decides that, as always.
model UnitPhoto {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  path        String   @unique
  contentType String
  bytes       Int
  width       Int?
  height      Int?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([unitId, createdAt])
}

/// One field of a unit's passport changing hands: what it said, what it says now, who, when.
/// A unit replaced whole leaves its old model and serial here; a capacitor swapped during a
/// repair will leave its old rating here once the technician's report writes the passport.
model UnitChange {
  id        Int      @id @default(autoincrement())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([unitId, changedAt(sort: Desc)])
}

model Sensor {
  id                  String    @id @default(cuid())
  devEui              String    @unique // uppercase hex, e.g. "A84041784362379C"
  ttnDeviceId         String? // "draginotst2"
  /// Dragino Node_type from the decoded payload: "LTC2" (two probes) or "LHT65N" (one probe + ambient).
  /// Updated from every uplink — the device is the source of truth.
  nodeType            String?
  /// Hardware model as written on the client's inventory, e.g. "LHT65N-NE117". Finer than
  /// nodeType, which is only what the decoder reports ("LHT65N" for both the N and S variants).
  model               String?
  /// Installer's label for the probe, e.g. "AC1-kitchen".
  label               String?
  locationId          String
  location            Location  @relation(fields: [locationId], references: [id])
  batteryV            Float?
  batteryPct          Int?
  /// Dragino Bat_status ("Good", "Low", …) — LHT65N reports it, LTC2 doesn't
  batStatus           String?
  lastRssi            Int?
  lastSnr             Float?
  /// LHT65N built-in air sensor (TempF_SHT / Hum_SHT) — the air around the device itself.
  /// For an AC unit this *is* the measurement that counts: the client judges an air
  /// conditioner by the room, not by the duct ("АС с дактов нерелевантное измерение").
  ambientTempF        Float?
  ambientHum          Float?
  /// External probe (TempF_TMP117) — supply air for an AC. Kept even where it is not what
  /// the unit is judged on, so no number the sensor reported is thrown away.
  probeTempF          Float?
  /// How often the device is configured to uplink. Offline threshold = 3 × interval + 60 s.
  expectedIntervalSec Int       @default(300)
  lastSeenAt          DateTime? @db.Timestamptz(6)

  channels SensorChannel[]
  readings Reading[]

  @@index([locationId])
}

/// One Dragino LTC2 has two probes; each probe (channel 1|2) may be wired to a unit or left unconnected.
model SensorChannel {
  id       String  @id @default(cuid())
  sensorId String
  sensor   Sensor  @relation(fields: [sensorId], references: [id])
  channel  Int // 1 | 2
  unitId   String?
  unit     Unit?   @relation(fields: [unitId], references: [id])

  @@unique([sensorId, channel])
  @@index([unitId])
}

model Reading {
  id         Int      @id @default(autoincrement())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id])
  channel    Int
  /// What the unit is judged by: the probe for cold storage, the room for an AC.
  tempF      Float
  /// The other number the same uplink carried, kept so both lines of an AC chart have a
  /// history. For an AC that is the duct probe; for cold storage there is nothing to add.
  probeTempF Float?
  measuredAt DateTime @db.Timestamptz(6) // uplink_message.received_at

  // TTN may deliver the same uplink twice — the same probe can't measure twice at the same instant
  @@unique([sensorId, channel, measuredAt])
  @@index([unitId, measuredAt(sort: Desc)])
}

model Alert {
  id             String    @id @default(cuid())
  unitId         String
  unit           Unit      @relation(fields: [unitId], references: [id])
  type           AlertType
  openedAt       DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime? @db.Timestamptz(6)
  peakTempF      Float?
  lastNotifiedAt DateTime? @db.Timestamptz(6)

  @@index([unitId, resolvedAt])
  @@index([resolvedAt])
}

/// Uplinks from dev_eui we don't know yet. Nothing is dropped silently — handy when wiring new sensors.
model UnknownUplink {
  id         Int      @id @default(autoincrement())
  devEui     String
  /// Why it landed here: unknown_device | unsupported_node_type:<type> | unparseable
  reason     String?
  payload    Json
  receivedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([devEui])
}
