# PostgreSQL connection string (all timestamps stored in UTC)
# Local dev without Docker:  npx prisma dev -n qimby -d   → copy the TCP url it prints
DATABASE_URL="postgres://postgres:postgres@localhost:51214/qimby?sslmode=disable"

# Shared secret TTN sends in the X-Webhook-Secret header (Integrations → Webhooks → Custom)
# Only for `npx prisma migrate dev` against the local `prisma dev` server (its shadow db lives on the next port)
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

TTN_WEBHOOK_SECRET="change-me"

# Optional: Telegram notifications. When unset, alerts are only logged to the console.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: set to 1 to disable the in-process offline check (e.g. when running scripts/offline-check.mts from cron)
# OFFLINE_CHECK_DISABLED=1
